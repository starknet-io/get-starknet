{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p dist && echo 'Moved to https://starknet-io.github.io/get-starknet/' > dist/index.html",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path(.*)",
      "destination": "https://starknet-io.github.io/get-starknet/:path",
      "permanent": true
    }
  ]
}
